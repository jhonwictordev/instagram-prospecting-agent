POSTGRES_DB=instagram_prospecting
POSTGRES_USER=prospecting
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://prospecting:change-me@localhost:5432/instagram_prospecting
N8N_ENCRYPTION_KEY=replace-with-long-random-value
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/
BROWSER_WORKER_URL=http://host.docker.internal:3001
BROWSER_WORKER_API_KEY=replace-with-long-random-value
PORT=3001
ALLOWED_ORIGIN=http://localhost:5678
BRAVE_EXECUTABLE_PATH=
BRAVE_USER_DATA_DIR=./storage/browser-profile
HEADLESS=false
DEFAULT_MAX_CONTACTS_PER_RUN=10
ABSOLUTE_MAX_CONTACTS_PER_RUN=20
MIN_ACTION_DELAY_SECONDS=90
MAX_ACTION_DELAY_SECONDS=240
MAX_CONSECUTIVE_ERRORS=3
OPERATION_TIMEOUT_MS=45000
AUTOMATIC_MODE_ENABLED=false
EMERGENCY_STOP=false
MESSAGE_MAX_LENGTH=900
LOG_LEVEL=info
TZ=America/Sao_Paulo
